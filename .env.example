# Local listener.
LENS_LISTEN=127.0.0.1:8787

# Text-only OpenAI-compatible upstream. The client's API key and model are
# forwarded unchanged.
TEXT_BASE_URL=https://text.example.com/v1
# Default: negotiate HTTP/2 when available. Use http1.1 if the text upstream
# advertises HTTP/2 but breaks streaming requests. This does not retry requests.
TEXT_HTTP_COMPATIBILITY_MODE=http2

# Vision-capable OpenAI-compatible upstream. The MVP calls
# {VISION_BASE_URL}/chat/completions.
VISION_BASE_URL=https://vision.example.com/v1
VISION_API_KEY=replace-me
VISION_MODEL=replace-me

# Optional tuning.
MAX_REQUEST_BYTES=67108864
MAX_IMAGE_BYTES=20971520
VISION_TIMEOUT_SECONDS=120
VISION_MAX_CONCURRENCY=3
VISION_CACHE_TTL_SECONDS=3600
VISION_CACHE_MAX_ENTRIES=256
